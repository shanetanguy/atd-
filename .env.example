# Copy to .env and set real values before deploying.
# The server reads these directly (via `node --env-file .env` or your host's env config).

# Shared password staff use to sign in. Anyone with this can create/edit inspections.
ATD_STAFF_PASSWORD=change-me

# Random secret used to sign staff session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Optional, defaults to 5174
PORT=5174
